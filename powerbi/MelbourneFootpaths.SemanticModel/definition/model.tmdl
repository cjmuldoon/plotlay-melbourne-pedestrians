model Model
	culture: en-AU
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-AU
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_QueryOrder = ["DataFolder","GetFile","Sensors","Hours","Daily","HourOfDay","DayType"]
annotation __PBI_TimeIntelligenceEnabled = 0

ref table Sensors
ref table Hours
ref table Daily
ref table HourOfDay
ref table DayType

ref cultureInfo en-AU

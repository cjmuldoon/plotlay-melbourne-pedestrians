table Daily
	lineageTag: c512b685-438f-41da-a738-6329a3b8f8d3

	column sensor_key
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: aa5688ce-235c-a636-f922-97c67f99885a
		summarizeBy: none
		sourceColumn: sensor_key

		annotation SummarizationSetBy = Automatic

	column date
		dataType: dateTime
		formatString: d mmm yyyy
		lineageTag: 09efe9b5-63d0-f812-5ba0-5bdff2b61e0b
		summarizeBy: none
		sourceColumn: date

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

	column people
		dataType: int64
		formatString: #,0
		lineageTag: 4c3c7027-49ea-c61f-2c0f-e1ff6c121f29
		summarizeBy: none
		sourceColumn: people

		annotation SummarizationSetBy = Automatic

	column hours_reported
		dataType: int64
		formatString: 0
		lineageTag: 9c9e002c-d6ff-2c61-bec3-3020c672cdd3
		summarizeBy: none
		sourceColumn: hours_reported

		annotation SummarizationSetBy = Automatic

	partition Daily = m
		mode: import
		source =
				let
				    Source = Csv.Document(GetFile("counts/daily_totals.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Kept = Table.SelectColumns(Promoted, {"sensor_key", "date", "people", "hours_reported"}),
				    Typed = Table.TransformColumnTypes(Kept, {{"sensor_key", Int64.Type}, {"date", type date}, {"people", Int64.Type}, {"hours_reported", Int64.Type}}, "en-AU")
				in
				    Typed

	annotation PBI_ResultType = Table


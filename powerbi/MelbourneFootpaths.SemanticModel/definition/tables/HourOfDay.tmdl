	partition HourOfDay = m
		mode: import
		source =
				let
				    Source = Table.FromColumns({List.Numbers(0, 24)}, type table [hour = Int64.Type]),
				    Clock = Table.AddColumn(Source, "clock", each Text.PadStart(Text.From([hour]), 2, "0") & ":00", type text)
				in

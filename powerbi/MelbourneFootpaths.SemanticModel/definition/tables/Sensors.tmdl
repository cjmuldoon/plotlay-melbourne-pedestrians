table Sensors
	lineageTag: af29aa17-8ae4-3211-319e-28f627e96590

	/// The average people in an hour: the sum over the sensors in the filter, averaged over the hours in the filter (and over weekdays and weekends unless a day type is picked)
	measure 'People an hour' = AVERAGEX ( VALUES ( Hours[hour] ), CALCULATE ( SUM ( Hours[people] ) ) )
		formatString: #,0
		lineageTag: a14c2fa8-718d-7607-c1bd-04b545425e32

	/// Footpath width from the zone shape: (P - SQRT(P^2 - 16A)) / 4
	measure 'Width m' = AVERAGE ( Sensors[width_m] )
		formatString: 0.0
		lineageTag: 4c3b3da5-327b-50f6-19d9-9c86c29899d8

	/// People an hour on each metre of footpath width (averaged over the sensors in the filter)
	measure 'People an hour per m' =
			VAR t = SUMX ( VALUES ( Sensors[sensor_key] ), DIVIDE ( CALCULATE ( [People an hour] ), CALCULATE ( [Width m] ) ) )
			RETURN DIVIDE ( t, DISTINCTCOUNT ( Sensors[sensor_key] ) )
		formatString: #,0
		lineageTag: 03b7d47c-7ac2-91dd-0005-1a77332d9ee0

	/// Space each person has: walking speed (1.2 m/s) x 3600 / people an hour per metre of width
	measure 'm2 each' = DIVIDE ( 1.2 * 3600, [People an hour per m] )
		formatString: 0.0
		lineageTag: 5e04e006-cee5-c36a-8b17-403432f53e3c

	/// A car space (AS/NZS 2890.1, class 1A) is 2.4 x 5.4 m
	measure 'Car spaces each' = DIVIDE ( [m2 each], 12.96 )
		formatString: 0.00
		lineageTag: 2bae85e2-cd3f-af58-a399-954d9f79129a

	/// The average weekday: the 24 hourly averages added up
	measure 'Weekday day' = CALCULATE ( SUM ( Hours[people] ), DayType[day_type] = "Weekday" )
		formatString: #,0
		displayFolder: Weekend
		lineageTag: 5b0bf5a7-b85c-5f38-4d03-5b30a1ad23a6

	measure 'Weekend day' = CALCULATE ( SUM ( Hours[people] ), DayType[day_type] = "Weekend" )
		formatString: #,0
		displayFolder: Weekend
		lineageTag: 6cf44ec0-6254-c251-278a-15a5546cb5b1

	/// Weekend day divided by weekday, as the formula column in Plotlay
	measure 'Weekend vs weekday' = DIVIDE ( [Weekend day], [Weekday day] )
		formatString: 0.00
		displayFolder: Weekend
		lineageTag: be4de268-bea6-5603-0cfa-086996ffda2b

	/// People counted in a day (all hours reported or not)
	measure 'People a day' = SUM ( Daily[people] )
		formatString: #,0
		displayFolder: Days
		lineageTag: ae7b25de-e52a-47b3-a35f-2124c40434a6

	measure 'Complete sensors' = CALCULATE ( DISTINCTCOUNT ( Daily[sensor_key] ), Daily[hours_reported] = 24 )
		formatString: 0
		displayFolder: Days
		lineageTag: 12932e89-6963-3081-56c0-42d4c7e571ca

	measure 'Sensor title' = SELECTEDVALUE ( Sensors[sensor_name], "Pick a sensor" )
		lineageTag: 22bd9627-475b-edd5-081b-feec429323ec

	column sensor_key
		dataType: int64
		formatString: 0
		lineageTag: 374d2122-0db9-8d12-238d-38d4184741d6
		summarizeBy: none
		sourceColumn: sensor_key

		annotation SummarizationSetBy = Automatic


table Sensors
	lineageTag: af29aa17-8ae4-3211-319e-28f627e96590

	/// The hour the measures use: the hour picked, or 17 (5 pm) when none is
	measure 'Hour shown' = IF ( HASONEVALUE ( HourOfDay[hour] ), VALUES ( HourOfDay[hour] ), 17 )
		formatString: 0
		lineageTag: c4a548a2-2ce4-bbca-fbfb-9d606cafca08

	/// Weekday or Weekend: the day type picked, or Weekday when none is
	measure 'Day type shown' = IF ( HASONEVALUE ( DayType[day_type] ), VALUES ( DayType[day_type] ), "Weekday" )
		lineageTag: 6a8a2f56-cee0-fb86-4f84-adb5837035a0

	/// Average people in the hour shown on the day type shown, added up over the sensors in the filter
	measure 'People an hour' =
			VAR h = [Hour shown]
			VAR d = [Day type shown]
			RETURN CALCULATE ( SUM ( Hours[people] ), HourOfDay[hour] = h, DayType[day_type] = d )
		formatString: #,0
		lineageTag: a14c2fa8-718d-7607-c1bd-04b545425e32

	/// Footpath width from the zone shape: (P - SQRT(P^2 - 16A)) / 4
	measure 'Width m' = AVERAGE ( Sensors[width_m] )
		formatString: #,0.0
		lineageTag: 4c3b3da5-327b-50f6-19d9-9c86c29899d8

	/// People an hour on each metre of footpath width, in the hour shown (averaged over the sensors in the filter)
	measure 'People an hour per m' = AVERAGEX ( FILTER ( VALUES ( Sensors[sensor_key] ), NOT ISBLANK ( [Width m] ) ), DIVIDE ( [People an hour], [Width m] ) )
		formatString: #,0
		lineageTag: 03b7d47c-7ac2-91dd-0005-1a77332d9ee0

	/// Space each person has in the hour shown: walking speed (1.2 m/s) x 3600 / people an hour per metre of width
	measure 'm2 each' = DIVIDE ( 1.2 * 3600, [People an hour per m] )
		formatString: #,0.0
		lineageTag: 5e04e006-cee5-c36a-8b17-403432f53e3c

	/// Median over the compared footpaths of each one's space each, in the hour shown
	measure 'Median m2 each' =
			MEDIANX (
			    FILTER ( CALCULATETABLE ( VALUES ( Sensors[sensor_key] ), KEEPFILTERS ( Sensors[compare] = TRUE () ) ), [People an hour] > 0 && NOT ISBLANK ( [Width m] ) ),
			    DIVIDE ( 1.2 * 3600 * [Width m], [People an hour] )
			)
		formatString: #,0.0
		lineageTag: 36c545f0-64a3-4145-bc72-ce22aea40c53

	/// A footpath's busiest hour on the day type shown (for one sensor)
	measure 'Peak people an hour' =
			VAR d = [Day type shown]
			RETURN CALCULATE ( MAXX ( VALUES ( HourOfDay[hour] ), CALCULATE ( SUM ( Hours[people] ) ) ), REMOVEFILTERS ( HourOfDay ), DayType[day_type] = d )
		formatString: #,0
		lineageTag: 27bb6116-c288-d0ce-b8d3-e419546ca417

	/// Median over the compared footpaths of the space each at each one's own busiest hour, on the day type shown (the README median)
	measure 'Median m2 each at peak' =
			MEDIANX (
			    FILTER ( CALCULATETABLE ( VALUES ( Sensors[sensor_key] ), KEEPFILTERS ( Sensors[compare] = TRUE () ) ), [Peak people an hour] > 0 && NOT ISBLANK ( [Width m] ) ),
			    DIVIDE ( 1.2 * 3600 * [Width m], [Peak people an hour] )
			)
		formatString: #,0.0
		lineageTag: bd59e9e1-2b2c-274b-e078-7b396423bd01

	/// A car space (AS/NZS 2890.1, class 1A) is 2.4 x 5.4 m
	measure 'Car spaces each' = DIVIDE ( [m2 each], 12.96 )
		formatString: 0.00
		lineageTag: 2bae85e2-cd3f-af58-a399-954d9f79129a

	/// The average weekday: the 24 hourly averages added up
	measure 'Weekday day' = CALCULATE ( SUM ( Hours[people] ), DayType[day_type] = "Weekday", REMOVEFILTERS ( HourOfDay ) )
		formatString: #,0
		displayFolder: Weekend
		lineageTag: 5b0bf5a7-b85c-5f38-4d03-5b30a1ad23a6

	measure 'Weekend day' = CALCULATE ( SUM ( Hours[people] ), DayType[day_type] = "Weekend", REMOVEFILTERS ( HourOfDay ) )
		formatString: #,0
		displayFolder: Weekend
		lineageTag: 6cf44ec0-6254-c251-278a-15a5546cb5b1

	/// Weekend day divided by weekday, as the formula column in Plotlay
	measure 'Weekend vs weekday' = DIVIDE ( [Weekend day], [Weekday day] )
		formatString: 0.00
		displayFolder: Weekend
		lineageTag: be4de268-bea6-5603-0cfa-086996ffda2b

	/// People counted in a day (all hours reported or not)
	measure 'People a day' = SUM ( Daily[people] )
		formatString: #,0
		displayFolder: Days
		lineageTag: ae7b25de-e52a-47b3-a35f-2124c40434a6

	/// The average day of each month (for the monthly line: a daily axis scrolled in Desktop)
	measure 'People a day, month average' = AVERAGEX ( VALUES ( Daily[date] ), [People a day] )
		formatString: #,0
		displayFolder: Days
		lineageTag: 89e08089-7aa0-ed0b-e364-d66d3103750f

	measure 'Complete sensors' = CALCULATE ( DISTINCTCOUNT ( Daily[sensor_key] ), Daily[hours_reported] = 24 )
		formatString: 0
		displayFolder: Days
		lineageTag: 12932e89-6963-3081-56c0-42d4c7e571ca

	measure 'Sensor title' = SELECTEDVALUE ( Sensors[sensor_name], "Pick a sensor" )
		lineageTag: 22bd9627-475b-edd5-081b-feec429323ec

	column sensor_key
		dataType: int64
		formatString: 0
		lineageTag: 374d2122-0db9-8d12-238d-38d4184741d6
		summarizeBy: none
		sourceColumn: sensor_key

		annotation SummarizationSetBy = Automatic

	column sensor_name
		dataType: string
		lineageTag: d4f51362-5454-4296-730e-9e0adfde6f9c
		summarizeBy: none
		sourceColumn: sensor_name

		annotation SummarizationSetBy = Automatic

	column latitude
		dataType: double
		lineageTag: 7bac260f-e216-7b21-6d67-e86785803d59
		summarizeBy: none
		sourceColumn: latitude
		dataCategory: Latitude

		annotation SummarizationSetBy = Automatic

	column longitude
		dataType: double
		lineageTag: 3126c4b2-537a-7a4e-9d29-fefaac0b4253
		summarizeBy: none
		sourceColumn: longitude
		dataCategory: Longitude

		annotation SummarizationSetBy = Automatic

	column zone_made_by
		dataType: string
		lineageTag: e185781d-8134-c3e6-1434-ca08801d70ae
		summarizeBy: none
		sourceColumn: zone_made_by

		annotation SummarizationSetBy = Automatic

	column zone_check
		dataType: string
		lineageTag: 89f897d9-2df1-f8d8-1ffe-eaa6a4a9f02c
		summarizeBy: none
		sourceColumn: zone_check

		annotation SummarizationSetBy = Automatic

	column compare
		dataType: boolean
		lineageTag: 328c1091-af94-564d-2636-44536600cdd8
		summarizeBy: none
		sourceColumn: compare

		annotation SummarizationSetBy = Automatic

	column note
		dataType: string
		lineageTag: cd635706-4812-079e-0f5a-20d00764ff48
		summarizeBy: none
		sourceColumn: note

		annotation SummarizationSetBy = Automatic

	column area_m2
		dataType: double
		formatString: #,0
		lineageTag: 2e656559-ab16-e2aa-a525-03e76e8b9c0b
		summarizeBy: none
		sourceColumn: area_m2

		annotation SummarizationSetBy = Automatic

	column perimeter_m
		dataType: double
		formatString: #,0.0
		lineageTag: ddd5bc2c-d73a-21bf-e303-8551ccab652f
		summarizeBy: none
		sourceColumn: perimeter_m

		annotation SummarizationSetBy = Automatic

	column width_m
		dataType: double
		formatString: 0.0
		lineageTag: 6245098a-1c4a-6cc6-e749-720bb1a6143b
		summarizeBy: none
		sourceColumn: width_m

		annotation SummarizationSetBy = Automatic

	column weekend_vs_weekday
		dataType: double
		formatString: 0.00
		lineageTag: f0cded2a-1662-bbb8-0f26-f03242eea797
		summarizeBy: none
		sourceColumn: weekend_vs_weekday

		annotation SummarizationSetBy = Automatic

	column m2_each_at_peak
		dataType: double
		formatString: 0.0
		lineageTag: 0e62fbbd-69e9-a241-e53b-74c5451f8d4b
		summarizeBy: none
		sourceColumn: m2_each_at_peak

		annotation SummarizationSetBy = Automatic

	column map_key
		dataType: string
		lineageTag: ee37cc5b-e57a-a986-8c68-7acf6e16e52b
		summarizeBy: none
		sourceColumn: map_key

		annotation SummarizationSetBy = Automatic

	column sensor_name_short
		dataType: string
		lineageTag: 67c2129c-33f4-d0af-1805-e43603586d3b
		summarizeBy: none
		sourceColumn: sensor_name_short

		annotation SummarizationSetBy = Automatic

	partition Sensors = m
		mode: import
		source =
				let
				    Source = Csv.Document(GetFile("counts/sensors.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Kept = Table.SelectColumns(Promoted, {"sensor_key", "sensor_name", "latitude", "longitude", "zone_made_by", "zone_check", "compare", "note", "area_m2", "perimeter_m", "width_m", "weekend_vs_weekday", "m2_each_at_peak"}),
				    Typed = Table.TransformColumnTypes(Kept, {{"sensor_key", Int64.Type}, {"sensor_name", type text}, {"latitude", type number}, {"longitude", type number}, {"zone_made_by", type text}, {"zone_check", type text}, {"compare", type logical}, {"note", type text}, {"area_m2", type number}, {"perimeter_m", type number}, {"width_m", type number}, {"weekend_vs_weekday", type number}, {"m2_each_at_peak", type number}}, "en-AU"),
				    Keyed = Table.AddColumn(Typed, "map_key", each Text.From([sensor_key]), type text),
				    ShortNames_sensor_name_short = [#"114 Flinders Street Car Park Footpath" = "114 Flinders St car park", #"61-67 Power Street Southbank" = "61-67 Power St…", #"Awning of Nationwide Parking 474 Flinders Street" = "474 Flinders Street", #"Bourke St - Spencer St (North)" = "Bourke St-Spencer St N", #"Bourke Street Mall (South)" = "Bourke St Mall (South)", #"Chinatown-Lt Bourke St (South)" = "Chinatown-Lt Bourke St S", #"Chinatown-Swanston St (North)" = "Chinatown-Swanston St…", #"Elizabeth St - Flinders St (East) - New footpath" = "Elizabeth St-Flinders St…", #"Elizabeth St-Lonsdale St (South)" = "Elizabeth St-Lonsdale St S", #"Flinders La-Swanston St (West)" = "Flinders La-Swanston St…", #"Flinders Ln -Degraves St (South)" = "Flinders Ln-Degraves St S", #"Flinders Underpass - Myki Barriers" = "Flinders Underpass gates", #"Flinders Underpass - Walkway" = "Flinders Underpass walk", #"Harbour Esplanade (West) - Pedestrian path" = "Harbour Esp W path", #"I-Hub Corner of King Street and Flinders Street (2-6 King)" = "King St and Flinders St", #"I-Hub Corner of King Street and Latrobe Street (317-335 King)" = "King St and Latrobe St", #"I-Hub Southern Cross Station - Bourke Street Entrance - North" = "Sthn Cross Bourke St N", #"I-Hub Southern Cross Station - Bourke Street Entrance - South" = "Sthn Cross Bourke St S", #"I-Hub Southern Cross Station - Lonsdale Street Entrance - South" = "Sthn Cross Lonsdale St S", #"La Trobe St- William St (South)" = "La Trobe St-William St S", #"Little Collins St-Swanston St (East)" = "Lt Collins St-Swanston…", #"Lonsdale St - Elizabeth St (North)" = "Lonsdale St-Elizabeth St…", #"Melbourne Central-Elizabeth St (East)" = "Melb Central-Elizabeth…", #"Melbourne Convention Exhibition Centre" = "MCEC", #"Mounted on Toilet - Spencer Street, Batman Park" = "Spencer St, Batman Park", #"QV2 Apartments, 300 Swanston Street" = "QV2, 300 Swanston Street", #"RMIT Building 22 - 330 Swanston Street" = "RMIT 22, 330 Swanston St", #"Spencer St-Collins St (North)" = "Spencer St-Collins St N", #"Spencer St-Collins St (South)" = "Spencer St-Collins St S", #"St Kilda Rd-Alexandra Gardens" = "St Kilda Rd-Alexandra…"],
				    Short_sensor_name_short = Table.AddColumn(Keyed, "sensor_name_short", each Record.FieldOrDefault(ShortNames_sensor_name_short, [sensor_name], [sensor_name]), type text)
				in
				    Short_sensor_name_short

	annotation PBI_ResultType = Table
